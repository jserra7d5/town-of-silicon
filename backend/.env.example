# Application Settings
APP_NAME=Town of Silicon
DEBUG=false
HOST=0.0.0.0
PORT=8000

# LLM Configuration
LLM_PROVIDER=local
LLM_MODEL_PATH=../models/oss-20b.Q4_K_M.gguf
LLM_CONTEXT_SIZE=65536
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=200
LLM_TIMEOUT=30

# Metal/GPU Configuration (M4 Pro optimized)
LLM_N_GPU_LAYERS=-1
LLM_N_THREADS=10
LLM_N_BATCH=512
LLM_USE_MLOCK=true

# OpenRouter (fallback, optional)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Game Settings
GAME_MODE=classic
DAY_BASE_DURATION=45.0
NIGHT_BASE_DURATION=30.0
DEFENSE_DURATION=20.0
JUDGMENT_DURATION=20.0

# AI Settings
AI_BATCH_SIZE=4
AI_ENABLE_EXTENSIONS=true
AI_MAX_EXTENSIONS=10

# Performance
ENABLE_AUTO_CALIBRATION=true
TARGET_AI_RESPONSE_TIME=3.0
