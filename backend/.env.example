# ============================================================================
# Town of Silicon - Environment Configuration
# ============================================================================
# Copy this file to .env and update the values as needed
# cp .env.example .env

# ============================================================================
# LLM Configuration
# ============================================================================

# Path to the GGUF model file (relative to backend/ or absolute)
LLM_MODEL_PATH=../models/oss-20b.Q4_K_M.gguf

# Context window size (64K = 65536 tokens)
# Allows entire game history without summarization
LLM_CONTEXT_SIZE=65536

# Number of CPU threads for inference
# M4 Pro: 8-12 threads recommended
# Adjust based on your CPU cores
LLM_N_THREADS=10

# GPU layers to offload (for Metal on Apple Silicon)
# -1 = offload all layers to GPU (recommended for M4 Pro)
# 0 = CPU only
LLM_N_GPU_LAYERS=-1

# Batch size for processing multiple tokens
# Higher = faster but more memory
LLM_N_BATCH=512

# Temperature for AI decisions (0.0-1.0)
# Lower = more deterministic, Higher = more creative
LLM_TEMPERATURE=0.7

# Maximum tokens per AI response
LLM_MAX_TOKENS=512

# ============================================================================
# Game Configuration
# ============================================================================

# Number of AI players to process in parallel
# M4 Pro 48GB: 4 recommended
# Lower if memory constrained
AI_BATCH_SIZE=4

# Default role list for games
DEFAULT_ROLE_LIST=classic

# Game timeout in seconds (0 = no timeout)
GAME_TIMEOUT=3600

# Enable debug logging
DEBUG=false

# ============================================================================
# Server Configuration
# ============================================================================

# Server host
HOST=0.0.0.0

# Server port
PORT=8000

# CORS origins (comma-separated)
# For development, allow localhost
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# WebSocket ping interval (seconds)
WS_PING_INTERVAL=30

# ============================================================================
# Advanced LLM Settings (Optional)
# ============================================================================

# Top-K sampling
# LLM_TOP_K=40

# Top-P (nucleus) sampling
# LLM_TOP_P=0.95

# Repeat penalty
# LLM_REPEAT_PENALTY=1.1

# Verbose logging for llama.cpp
# LLM_VERBOSE=false

# Use mmap for model loading (faster startup)
# LLM_USE_MMAP=true

# Use mlock to prevent swapping (requires RAM)
# LLM_USE_MLOCK=false

# Seed for reproducibility (0 = random)
# LLM_SEED=0
